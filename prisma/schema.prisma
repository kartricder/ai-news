// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Article {
  id                   String   @id @default(cuid())
  title                String
  titleVi              String   @default("")
  slug                 String   @unique
  summaryVi            String
  briefVi              String   @default("")
  whyImportant         String   @default("")
  contentVi            String   @default("")
  sourceName           String
  sourceUrl            String
  originalUrl          String
  originalTitle        String   @default("")
  originalPublishedAt  DateTime?
  fetchedAt            DateTime @default(now())
  publishedAt          DateTime?
  category             String   @default("general")
  tags                 String   @default("")
  aiTags               String   @default("")
  targetAudience       String   @default("")
  impactLevel          String   @default("")
  importanceScore      Int      @default(0)
  reasonForScore       String   @default("")
  status               String   @default("draft") // draft, pending, published, rejected
  aiProvider           String   @default("")
  aiModel              String   @default("")
  aiStatus             String   @default("pending") // pending, success, failed, blocked, fallback_success
  aiError              String   @default("")
  aiProcessedAt        DateTime?
  duplicateOfId        String?
  duplicateReason      String   @default("")
  canonicalUrl         String   @default("")
  identityKey          String?  @unique
  sourceId             String?
  externalId           String?
  fingerprint          String   @default("")
  pendingFingerprint   String   @default("")
  contentChangedAt     DateTime?
  identityReviewReason String   @default("")
  originalText         String   @default("")
  originalLanguage     String?
  evidenceLevel        String   @default("title_only")
  qualityFlags         String   @default("[]")
  processingReason     String   @default("")
  eventKey             String?
  externalVersion      String?
  scoreVersion         String   @default("")
  scoreBreakdown       String   @default("{}")
  publisherKey         String   @default("")
  sourceKind           String   @default("media")
  processingStatus     String   @default("review")
  processingAttempts   Int      @default(0)
  nextRetryAt          DateTime?
  leaseUntil           DateTime?
  leaseOwner           String?
  promptVersion        String   @default("")
  schemaVersion        String   @default("")
  inputHash            String   @default("")
  aiClaims             String   @default("[]")
  aiUncertainties      String   @default("[]")
  telegramSent         Boolean  @default(false)
  contentHash          String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([importanceScore])
  @@index([sourceName])
  @@index([sourceUrl])
  @@index([originalUrl])
  @@index([canonicalUrl])
  @@index([contentHash])
  @@index([duplicateOfId])
  @@index([createdAt])
  @@index([slug])
  @@index([eventKey, originalPublishedAt])
  @@index([status, processingStatus, nextRetryAt])
}

model Source {
  id         String   @id @default(cuid())
  name       String   @unique
  type       String   // rss, api, github, reddit, hackernews, facebook, custom
  url        String
  enabled    Boolean  @default(true)
  configJson String   @default("{}")
  catalogId  String?  @unique
  publisherKey String @default("")
  kind String @default("")
  language String?
  discoveryUrl String @default("")
  verificationStatus String @default("unverified")
  verifiedAt DateTime?
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastError String @default("")
  consecutiveFailures Int @default(0)
  nextAttemptAt DateTime?
  etag String?
  lastModified String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SourceFetchLog {
  id String @id @default(cuid())
  runId String?
  sourceId String
  status String
  fetchedCount Int @default(0)
  durationMs Int
  httpStatus Int?
  errorCode String?
  fetchedAt DateTime @default(now())
  @@index([runId])
  @@index([sourceId, fetchedAt])
}

model NewsCluster {
  id String @id @default(cuid())
  eventKey String @unique
  createdAt DateTime @default(now())
}

model NewsClusterLink {
  id String @id @default(cuid())
  clusterId String
  articleId String
  confidence Float
  reasons String @default("[]")
  status String @default("suggested")
  createdAt DateTime @default(now())
  @@unique([clusterId, articleId])
  @@index([articleId])
}

model CrawlRun {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String    @default("running") // running, completed, failed
  totalFetched    Int       @default(0)
  totalPublished  Int       @default(0)
  totalRejected   Int       @default(0)
  totalPending    Int       @default(0)
  totalCandidates Int       @default(0)
  totalDuplicates Int       @default(0)
  aiSuccess        Int       @default(0)
  aiFailed         Int       @default(0)
  telegramSent     Int       @default(0)
  repoRadarFound   Int       @default(0)
  errorMessage    String    @default("")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiAttempt {
  id String @id
  articleId String?
  repoId String?
  requestId String?
  requestedModel String
  model String @default("")
  provider String @default("")
  status String @default("reserved")
  errorCode String @default("")
  latencyMs Int @default(0)
  inputTokens Int?
  outputTokens Int?
  actualUsd Float?
  promptVersion String
  schemaVersion String
  createdAt DateTime @default(now())
  @@index([articleId, createdAt])
  @@index([repoId, createdAt])
}

model AiBudgetDay {
  day String @id
  spentMicros BigInt @default(0)
  reservedMicros BigInt @default(0)
  unknownCount Int @default(0)
}

model AiReservation {
  id String @id
  day String
  estimatedMicros BigInt
  actualMicros BigInt?
  status String @default("reserved")
  createdAt DateTime @default(now())
  settledAt DateTime?
  @@index([day, status])
}

model AiResultCache {
  id String @id @default(cuid())
  articleId String
  inputHash String
  promptVersion String
  schemaVersion String
  resultJson String
  createdAt DateTime @default(now())
  @@unique([articleId, inputHash, promptVersion, schemaVersion])
}

model AdminAudit {
  id String @id @default(cuid())
  actor String
  action String
  articleId String?
  beforeJson String
  afterJson String
  createdAt DateTime @default(now())
  @@index([articleId, createdAt])
}

model WorkerLease {
  name String @id
  owner String
  leaseUntil DateTime
}

model TelegramLog {
  id             String    @id @default(cuid())
  articleId      String
  chatIdMasked   String    @default("")
  status         String    @default("pending") // pending, sent, failed
  errorMessage   String    @default("")
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
}

model RepoRadarItem {
  id           String   @id @default(cuid())
  repoName     String
  fullName     String   @unique
  description  String   @default("")
  url          String
  owner        String
  stars        Int      @default(0)
  forks        Int      @default(0)
  watchers     Int      @default(0)
  language     String   @default("")
  topics       String   @default("")
  lastPushedAt DateTime?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  repoScore    Int      @default(0)
  aiSummaryVi  String   @default("")
  whyImportant String   @default("")
  status       String   @default("tracked") // tracked, published, ignored
  aiProvider   String   @default("")
  aiModel      String   @default("")
  aiStatus     String   @default("pending")
  aiError      String   @default("")
  processingAttempts Int @default(0)
  nextRetryAt DateTime?
  leaseOwner String?
  leaseUntil DateTime?
  inputHash String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([repoScore])
  @@index([status])
  @@index([lastPushedAt])
}
